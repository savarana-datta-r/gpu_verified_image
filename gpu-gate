#!/bin/sh
# gpu-gate — asks for a code from an authenticator app before handing over a
# shell, run as sshd ForceCommand.
#
# THIS VARIANT TALKS TO NOTHING. The code is checked on this machine against a
# TOTP secret supplied at launch, so the image works on any GPU, at any
# provider, with no gateway, no network and no email. The trade is deliberate:
# there is no central record of who logged in, because there is nobody to tell.
# If you want the record, use the gateway-backed variant instead.
#
# WHAT IT PROTECTS. An SSH key on its own stops being enough: whoever holds the
# key must also hold the authenticator device. That is the entire claim.
#
# NOT a security boundary: the tenant has root. They can read the secret out of
# /etc/gpu-gateway/totp.env and delete this line from sshd_config. It raises the
# cost of a stolen key; it does not confine the person renting the machine.
#
# WHAT GETS CHALLENGED. Anything with a terminal, since a terminal is what can
# answer a prompt. Everything without one passes through untouched —
# scp/sftp/rsync cannot be prompted and gating them would break every transfer:
#   no tty, command set                 -> `ssh host cmd`, old scp, rsync: exec it
#   no tty, no command                  -> sftp subsystem or `ssh -T`: exec sftp-server
#   a tty (command or not)              -> CHALLENGE, then run what was asked for
#
# The tty is tested before the command. The other way round, `ssh -tt host
# bash -i` passed through: an interactive shell, unchallenged.

set -u
CONF=/etc/gpu-gateway/totp.env
STATE=/run/gpu-gate-last

# Accept a code from the window before and after the current one, so a client
# clock a few seconds out still works. Each step is 30s, so this tolerates
# roughly +/-30s of skew. Widening it widens the window an intercepted code
# stays usable in.
WINDOW=${GPU_TOTP_WINDOW:-1}

# Log to syslog, not a file: the gate runs as the unprivileged login user under
# ForceCommand and cannot write a root-owned log — and a failed redirection
# would leak onto the user's own terminal. The secret is never logged.
log() { logger -t gpu-gate -- "$*" 2>/dev/null || true; }

login_shell() {
  # pam_motd never runs under a ForceCommand, so the banner is printed here.
  [ -x /etc/blackbox/render-motd.sh ] && /etc/blackbox/render-motd.sh >&2 2>/dev/null
  SH=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
  [ -n "$SH" ] || SH=/bin/bash
  exec "$SH" -l
}
sftp_server() {
  for p in /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server /usr/lib/sftp-server; do
    [ -x "$p" ] && exec "$p"
  done
  exec internal-sftp 2>/dev/null || { echo "sftp unavailable" >&2; exit 1; }
}
# Run what the client asked for, so a requested command is honoured rather than
# replaced by a shell.
proceed() {
  if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    exec ${SHELL:-/bin/sh} -c "$SSH_ORIGINAL_COMMAND"
  fi
  login_shell
}
# For when the login CANNOT BE CHECKED: no secret, or no tool to check it with.
# Never for a code that was checked and rejected — a missing secret must not
# lock a customer out, a wrong code must not let anyone in.
failmode_exit() {
  if [ "${FAILMODE:-open}" = "closed" ]; then
    log "cannot verify, failmode=closed -> DENY"
    echo "Two-factor verification is unavailable and this machine is set to fail closed." >&2
    exit 1
  fi
  log "cannot verify, failmode=open -> allow (unverified)"
  proceed
}

# ── pass-through cases: no terminal, so nothing could answer a prompt ───────
if ! tty -s; then
  if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    log "passthrough cmd (user=$(id -un) host=${SSH_CLIENT%% *})"
    proceed
  fi
  log "passthrough no-tty (sftp/ -T) (user=$(id -un))"
  sftp_server
fi

# ── a terminal is attached: this is what we gate ────────────────────────────
RHOST="${SSH_CLIENT%% *}"; LUSER="$(id -un)"

# No config: there is no secret and no policy to honour. Allow, and say so in
# the log rather than silently behaving like an ungated machine.
[ -r "$CONF" ] || { log "no config at $CONF -> allow unverified"; proceed; }
. "$CONF"
SECRET="${GPU_TOTP_SECRET:-}"; FAILMODE="${GPU_TOTP_FAILMODE:-open}"

# Read but unusable. Here the policy IS known, so it decides: this is the same
# "cannot verify" as a missing tool, and allowing it outright would make
# fail-closed behave as fail-open.
[ -n "$SECRET" ] || { log "no secret configured -> failmode"; failmode_exit; }
command -v oathtool >/dev/null 2>&1 || { log "oathtool missing -> failmode"; failmode_exit; }

printf '\nThis machine requires a code from your authenticator app.\n' >&2

# ── prompt and verify, entirely on this machine ─────────────────────────────
i=1
while [ "$i" -le 3 ]; do
  printf 'Enter the 6-digit code: ' >&2
  IFS= read -r CODE || break
  CODE=$(printf '%s' "$CODE" | tr -cd '0-9')
  if [ -z "$CODE" ]; then
    printf 'No code entered.\n' >&2
    i=$((i + 1)); continue
  fi

  # Replay guard. A code stays valid for its whole step, and with WINDOW set it
  # is accepted either side of that, so the same six digits could otherwise be
  # presented twice inside roughly a minute and a half. Refusing a code we have
  # already honoured closes that without needing any state beyond the last one.
  NOW=$(date +%s 2>/dev/null || echo 0)
  SEEN=""
  if [ -r "$STATE" ]; then
    SEEN=$(cut -d' ' -f1 "$STATE" 2>/dev/null)
    SEEN_AT=$(cut -d' ' -f2 "$STATE" 2>/dev/null)
    [ -n "${SEEN_AT:-}" ] && [ "$((NOW - SEEN_AT))" -gt 90 ] && SEEN=""
  fi
  if [ -n "$SEEN" ] && [ "$SEEN" = "$CODE" ]; then
    log "replayed code refused (user=$LUSER host=$RHOST)"
    printf 'That code has already been used. Wait for the next one.\n' >&2
    i=$((i + 1)); continue
  fi

  # oathtool validates the code itself when given one, searching WINDOW steps,
  # and exits non-zero if it does not match. Output is discarded: on success it
  # prints the matching position, which is of no use to the person logging in,
  # and on failure it can echo the secret's length.
  if oathtool --totp -b --window="$WINDOW" "$SECRET" "$CODE" >/dev/null 2>&1; then
    printf '%s %s\n' "$CODE" "$NOW" > "$STATE" 2>/dev/null || true
    chmod 600 "$STATE" 2>/dev/null || true
    log "verified (user=$LUSER host=$RHOST)"
    printf 'Verified.\n' >&2
    proceed
  fi
  printf 'Incorrect or expired code.\n' >&2
  i=$((i + 1))
done
log "denied after 3 attempts (user=$LUSER host=$RHOST)"
echo "Two-factor verification failed." >&2
exit 1
